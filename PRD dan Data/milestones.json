          "domain": "sosial",
          "text": "Bermain bersama Anda, seperti tepuk tangan (pat-a-cake)"
        },
        {
          "id": "CDC-12-2",
          "domain": "bahasa",
          "text": "Melambaikan tangan 'dadah'"
        },
        {
          "id": "CDC-12-3",
          "domain": "bahasa",
          "text": "Memanggil orang tua 'mama'/'papa' atau sebutan khusus lain"
        },
        {
          "id": "CDC-12-4",
          "domain": "bahasa",
          "text": "Mengerti 'jangan' (berhenti sebentar saat dilarang)"
        },
        {
          "id": "CDC-12-5",
          "domain": "kognitif",
          "text": "Memasukkan benda ke wadah, seperti balok ke gelas"
        },
        {
          "id": "CDC-12-6",
          "domain": "kognitif",
          "text": "Mencari benda yang disembunyikan di depannya"
        },
        {
          "id": "CDC-12-7",
          "domain": "motorik_kasar",
          "text": "Menarik badan untuk berdiri"
        },
        {
          "id": "CDC-12-8",
          "domain": "motorik_kasar",
          "text": "Berjalan sambil berpegangan pada perabot"
        },
        {
          "id": "CDC-12-9",
          "domain": "kemandirian",
          "text": "Minum dari gelas tanpa tutup yang Anda pegangi"
        },
        {
          "id": "CDC-12-10",
          "domain": "motorik_halus",
          "text": "Mengambil benda kecil dengan ibu jari dan telunjuk"
        }
      ],
      "source": "CDC_12M",
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 15,
      "items": [
        {
          "id": "CDC-15-1",
          "domain": "sosial",
          "text": "Meniru anak lain saat bermain"
        },
        {
          "id": "CDC-15-2",
          "domain": "sosial",
          "text": "Menunjukkan benda yang ia sukai kepada Anda"
        },
        {
          "id": "CDC-15-3",
          "domain": "sosial",
          "text": "Bertepuk tangan saat senang"
        },
        {
          "id": "CDC-15-4",
          "domain": "sosial",
          "text": "Memeluk boneka atau mainan"
        },
        {
          "id": "CDC-15-5",
          "domain": "sosial",
          "text": "Menunjukkan kasih sayang (memeluk, mencium)"
        },
        {
          "id": "CDC-15-6",
          "domain": "bahasa",
          "text": "Mencoba mengucapkan 1-2 kata selain 'mama/papa'"
        },
        {
          "id": "CDC-15-7",
          "domain": "bahasa",
          "text": "Melihat benda yang dikenal saat Anda menyebut namanya"
        },
        {
          "id": "CDC-15-8",
          "domain": "bahasa",
          "text": "Mengikuti perintah yang disertai isyarat dan kata"
        },
        {
          "id": "CDC-15-9",
          "domain": "bahasa",
          "text": "Menunjuk untuk meminta sesuatu atau minta bantuan"
        },
        {
          "id": "CDC-15-10",
          "domain": "kognitif",
          "text": "Mencoba memakai benda dengan benar (telepon, gelas, buku)"
        },
        {
          "id": "CDC-15-11",
          "domain": "motorik_halus",
          "text": "Menumpuk minimal dua benda kecil seperti balok"
        },
        {
          "id": "CDC-15-12",
          "domain": "motorik_kasar",
          "text": "Melangkah beberapa langkah sendiri"
        },
        {
          "id": "CDC-15-13",
          "domain": "kemandirian",
          "text": "Makan sebagian makanan dengan jarinya sendiri"
        }
      ],
      "source": "CDC_15M",
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 18,
      "items": [
        {
          "id": "CDC-18-1",
          "domain": "sosial",
          "text": "Menjauh dari Anda tetapi menoleh memastikan Anda dekat"
        },
        {
          "id": "CDC-18-2",
          "domain": "sosial",
          "text": "Menunjuk untuk memperlihatkan sesuatu yang menarik"
        },
        {
          "id": "CDC-18-3",
          "domain": "kemandirian",
          "text": "Menyodorkan tangan untuk dicuci"
        },
        {
          "id": "CDC-18-4",
          "domain": "sosial",
          "text": "Melihat beberapa halaman buku bersama Anda"
        },
        {
          "id": "CDC-18-5",
          "domain": "kemandirian",
          "text": "Membantu saat dipakaikan baju (memasukkan lengan, mengangkat kaki)"
        },
        {
          "id": "CDC-18-6",
          "domain": "bahasa",
          "text": "Mencoba mengucapkan 3 kata atau lebih selain 'mama/papa'"
        },
        {
          "id": "CDC-18-7",
          "domain": "bahasa",
          "text": "Mengikuti perintah satu langkah tanpa isyarat"
        },
        {
          "id": "CDC-18-8",
          "domain": "kognitif",
          "text": "Meniru Anda mengerjakan pekerjaan rumah (menyapu)"
        },
        {
          "id": "CDC-18-9",
          "domain": "kognitif",
          "text": "Bermain mainan secara sederhana (mendorong mobil-mobilan)"
        },
        {
          "id": "CDC-18-10",
          "domain": "motorik_kasar",
          "text": "Berjalan tanpa berpegangan"
        },
        {
          "id": "CDC-18-11",
          "domain": "motorik_halus",
          "text": "Mencoret-coret"
        },
        {
          "id": "CDC-18-12",
          "domain": "kemandirian",
          "text": "Minum dari gelas tanpa tutup, kadang tumpah"
        },
        {
          "id": "CDC-18-13",
          "domain": "kemandirian",
          "text": "Makan sendiri dengan jari"
        },
        {
          "id": "CDC-18-14",
          "domain": "kemandirian",
          "text": "Mencoba memakai sendok"
        },
        {
          "id": "CDC-18-15",
          "domain": "motorik_kasar",
          "text": "Naik-turun sofa/kursi tanpa bantuan"
        }
      ],
      "source": "CDC_18M",
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 24,
      "items": [
        {
          "id": "CDC-24-1",
          "domain": "sosial",
          "text": "Menyadari saat orang lain terluka/sedih"
        },
        {
          "id": "CDC-24-2",
          "domain": "sosial",
          "text": "Melihat wajah Anda untuk tahu cara bereaksi di situasi baru"
        },
        {
          "id": "CDC-24-3",
          "domain": "bahasa",
          "text": "Menunjuk gambar di buku saat ditanya ('Mana beruangnya?')"
        },
        {
          "id": "CDC-24-4",
          "domain": "bahasa",
          "text": "Mengucapkan minimal dua kata bersamaan ('mau susu')"
        },
        {
          "id": "CDC-24-5",
          "domain": "bahasa",
          "text": "Menunjuk minimal dua bagian tubuh saat diminta"
        },
        {
          "id": "CDC-24-6",
          "domain": "bahasa",
          "text": "Memakai isyarat selain melambai dan menunjuk (cium jauh, mengangguk)"
        },
        {
          "id": "CDC-24-7",
          "domain": "motorik_halus",
          "text": "Memegang benda di satu tangan sambil memakai tangan lain (membuka tutup wadah)"
        },
        {
          "id": "CDC-24-8",
          "domain": "kognitif",
          "text": "Mencoba memakai tombol/saklar/kenop pada mainan"
        },
        {
          "id": "CDC-24-9",
          "domain": "kognitif",
          "text": "Bermain dengan lebih dari satu mainan sekaligus"
        },
        {
          "id": "CDC-24-10",
          "domain": "motorik_kasar",
          "text": "Menendang bola"
        },
        {
          "id": "CDC-24-11",
          "domain": "motorik_kasar",
          "text": "Berlari"
        },
        {
          "id": "CDC-24-12",
          "domain": "motorik_kasar",
          "text": "Berjalan (bukan merangkak) naik beberapa anak tangga"
        },
        {
          "id": "CDC-24-13",
          "domain": "kemandirian",
          "text": "Makan dengan sendok"
        }
      ],
      "source": "CDC_2Y",
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 30,
      "source": "CDC_30M",
      "items": [
        {
          "id": "CDC-30-1",
          "domain": "sosial",
          "text": "Bermain di samping anak lain dan kadang bermain bersama"
        },
        {
          "id": "CDC-30-2",
          "domain": "sosial",
          "text": "Menunjukkan kemampuannya sambil berkata 'Lihat aku!'"
        },
        {
          "id": "CDC-30-3",
          "domain": "sosial",
          "text": "Mengikuti rutinitas sederhana bila diminta, misalnya membereskan mainan saat 'waktunya beres-beres'"
        },
        {
          "id": "CDC-30-4",
          "domain": "bahasa",
          "text": "Mengucapkan sekitar 50 kata"
        },
        {
          "id": "CDC-30-5",
          "domain": "bahasa",
          "text": "Menggabungkan dua kata atau lebih dengan satu kata kerja, misalnya 'Kucing lari'"
        },
        {
          "id": "CDC-30-6",
          "domain": "bahasa",
          "text": "Menyebut nama benda di buku saat ditunjuk dan ditanya 'Ini apa?'"
        },
        {
          "id": "CDC-30-7",
          "domain": "bahasa",
          "text": "Memakai kata 'aku', 'saya', atau 'kita'"
        },
        {
          "id": "CDC-30-8",
          "domain": "kognitif",
          "text": "Memakai benda untuk berpura-pura, misalnya menyuapi boneka dengan balok"
        },
        {
          "id": "CDC-30-9",
          "domain": "kognitif",
          "text": "Menunjukkan pemecahan masalah sederhana, misalnya naik bangku kecil untuk meraih sesuatu"
        },
        {
          "id": "CDC-30-10",
          "domain": "kognitif",
          "text": "Mengikuti perintah dua langkah, misalnya 'Taruh mainannya lalu tutup pintunya'"
        },
        {
          "id": "CDC-30-11",
          "domain": "kognitif",
          "text": "Mengenal minimal satu warna, misalnya menunjuk krayon merah saat ditanya"
        },
        {
          "id": "CDC-30-12",
          "domain": "motorik_halus",
          "text": "Memutar benda dengan tangan, seperti gagang pintu atau tutup botol"
        },
        {
          "id": "CDC-30-13",
          "domain": "kemandirian",
          "text": "Melepas sebagian baju sendiri, seperti celana longgar atau jaket terbuka"
        },
        {
          "id": "CDC-30-14",
          "domain": "motorik_kasar",
          "text": "Melompat dengan kedua kaki terangkat dari lantai"
        },
        {
          "id": "CDC-30-15",
          "domain": "motorik_halus",
          "text": "Membalik halaman buku satu per satu saat dibacakan"
        }
      ],
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 36,
      "items": [
        {
          "id": "CDC-36-1",
          "domain": "sosial",
          "text": "Tenang dalam 10 menit setelah ditinggal (mis. di penitipan)"
        },
        {
          "id": "CDC-36-2",
          "domain": "sosial",
          "text": "Memperhatikan anak lain dan ikut bermain"
        },
        {
          "id": "CDC-36-3",
          "domain": "bahasa",
          "text": "Bercakap dengan minimal dua kali saling balas"
        },
        {
          "id": "CDC-36-4",
          "domain": "bahasa",
          "text": "Bertanya 'siapa', 'apa', 'di mana', atau 'kenapa'"
        },
        {
          "id": "CDC-36-5",
          "domain": "bahasa",
          "text": "Menyebut aksi dalam gambar/buku saat ditanya (lari, makan)"
        },
        {
          "id": "CDC-36-6",
          "domain": "bahasa",
          "text": "Menyebut nama depannya saat ditanya"
        },
        {
          "id": "CDC-36-7",
          "domain": "bahasa",
          "text": "Bicara cukup jelas untuk dipahami orang lain hampir setiap saat"
        },
        {
          "id": "CDC-36-8",
          "domain": "kognitif",
          "text": "Menggambar lingkaran setelah dicontohkan"
        },
        {
          "id": "CDC-36-9",
          "domain": "kognitif",
          "text": "Menghindari benda panas saat diperingatkan"
        },
        {
          "id": "CDC-36-10",
          "domain": "motorik_halus",
          "text": "Meronce benda besar (manik besar, makaroni)"
        },
        {
          "id": "CDC-36-11",
          "domain": "kemandirian",
          "text": "Memakai sebagian baju sendiri (celana longgar, jaket)"
        },
        {
          "id": "CDC-36-12",
          "domain": "kemandirian",
          "text": "Memakai garpu"
        }
      ],
      "source": "CDC_3Y",
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 48,
      "items": [
        {
          "id": "CDC-48-1",
          "domain": "sosial",
          "text": "Berpura-pura menjadi sesuatu saat bermain (guru, superhero, anjing)"
        },
        {
          "id": "CDC-48-2",
          "domain": "sosial",
          "text": "Minta bermain dengan anak lain jika tidak ada teman"
        },
        {
          "id": "CDC-48-3",
          "domain": "sosial",
          "text": "Menghibur orang lain yang sedih/terluka"
        },
        {
          "id": "CDC-48-4",
          "domain": "sosial",
          "text": "Menghindari bahaya (tidak melompat dari tempat tinggi)"
        },
        {
          "id": "CDC-48-5",
          "domain": "sosial",
          "text": "Suka menjadi 'pembantu'"
        },
        {
          "id": "CDC-48-6",
          "domain": "sosial",
          "text": "Mengubah perilaku sesuai tempat (tempat ibadah, perpustakaan, taman)"
        },
        {
          "id": "CDC-48-7",
          "domain": "bahasa",
          "text": "Mengucapkan kalimat 4 kata atau lebih"
        },
        {
          "id": "CDC-48-8",
          "domain": "bahasa",
          "text": "Menyanyikan/menyebut sebagian kata dari lagu atau cerita"
        },
        {
          "id": "CDC-48-9",
          "domain": "bahasa",
          "text": "Menceritakan minimal satu kejadian hari itu"
        },
        {
          "id": "CDC-48-10",
          "domain": "bahasa",
          "text": "Menjawab pertanyaan sederhana ('Jaket untuk apa?')"
        },
        {
          "id": "CDC-48-11",
          "domain": "kognitif",
          "text": "Menyebut beberapa warna benda"
        },
        {
          "id": "CDC-48-12",
          "domain": "kognitif",
          "text": "Menebak kelanjutan cerita yang sudah dikenal"
        },
        {
          "id": "CDC-48-13",
          "domain": "kognitif",
          "text": "Menggambar orang dengan 3 bagian tubuh atau lebih"
        },
        {
          "id": "CDC-48-14",
          "domain": "motorik_kasar",
          "text": "Menangkap bola besar hampir setiap kali"
        },
        {
          "id": "CDC-48-15",
          "domain": "kemandirian",
          "text": "Mengambil makanan/menuang air sendiri dengan diawasi"
        },
        {
          "id": "CDC-48-16",
          "domain": "motorik_halus",
          "text": "Membuka beberapa kancing"
        },
        {
          "id": "CDC-48-17",
          "domain": "motorik_halus",
          "text": "Memegang krayon/pensil dengan jari dan jempol (bukan digenggam)"
        }
      ],
      "source": "CDC_4Y",
      "related_source": "CDC_MILESTONES_2022"
    },
    {
      "age_months": 60,
      "items": [
        {
          "id": "CDC-60-1",
          "domain": "sosial",
          "text": "Mengikuti aturan atau bergiliran saat bermain dengan anak lain"
        },
        {
          "id": "CDC-60-2",
          "domain": "sosial",
          "text": "Bernyanyi, menari, atau berakting untuk Anda"
        },
        {
          "id": "CDC-60-3",
          "domain": "kemandirian",
          "text": "Mengerjakan tugas rumah sederhana (memasangkan kaus kaki, membereskan meja)"
        },
        {
          "id": "CDC-60-4",
          "domain": "bahasa",
          "text": "Menceritakan kisah dengan minimal dua kejadian"
        },
        {
          "id": "CDC-60-5",
          "domain": "bahasa",
          "text": "Menjawab pertanyaan sederhana tentang buku/cerita"
        },
        {
          "id": "CDC-60-6",
          "domain": "bahasa",
          "text": "Mempertahankan percakapan lebih dari tiga kali saling balas"
        },
        {
          "id": "CDC-60-7",
          "domain": "bahasa",
          "text": "Mengenali/membuat rima sederhana"
        },
        {
          "id": "CDC-60-8",
          "domain": "kognitif",
          "text": "Berhitung sampai 10"
        },
        {
          "id": "CDC-60-9",
          "domain": "kognitif",
          "text": "Menyebut beberapa angka 1-5 saat ditunjuk"
        },
        {
          "id": "CDC-60-10",
          "domain": "kognitif",
          "text": "Memakai kata waktu (kemarin, besok, pagi, malam)"
        },
        {
          "id": "CDC-60-11",
          "domain": "kognitif",
          "text": "Fokus 5-10 menit dalam kegiatan (bukan layar)"
        },
        {
          "id": "CDC-60-12",
          "domain": "kognitif",
          "text": "Menulis beberapa huruf namanya"
        },
        {
          "id": "CDC-60-13",
          "domain": "kognitif",
          "text": "Menyebut beberapa huruf saat ditunjuk"
        },
        {
          "id": "CDC-60-14",
          "domain": "motorik_halus",
          "text": "Mengancingkan beberapa kancing"
        },
        {
          "id": "CDC-60-15",
          "domain": "motorik_kasar",
          "text": "Melompat dengan satu kaki"
        }
      ],
      "source": "CDC_5Y",
      "related_source": "CDC_MILESTONES_2022"
    }
